# MiAI V0.7 — ONLINE FIRST
# No local model or GPU is required on the development phone.

MIAI_PROVIDER=openai_compatible
MIAI_MODEL=llama3.2:3b
MIAI_OLLAMA_URL=http://localhost:11434

# Recommended Vision path: remote OpenAI-compatible service
MIAI_VISION_PROVIDER=openai_compatible
MIAI_VISION_MODEL=<vision-model>
MIAI_VISION_BASE_URL=https://example.com/v1
MIAI_VISION_API_KEY=pon-la-en-tu-entorno

# If omitted, Vision can reuse MIAI_BASE_URL / MIAI_API_KEY.
# MIAI_BASE_URL=https://example.com/v1
# MIAI_API_KEY=pon-la-en-tu-entorno

# Optional local Vision provider (only if deliberately running Ollama)
# MIAI_VISION_PROVIDER=ollama
# MIAI_VISION_MODEL=<ollama-vision-model>

# CI/testing provider
# MIAI_VISION_PROVIDER=mock

# Maximum Base64 image payload (~11 MB raw image at default)
MIAI_MAX_IMAGE_BASE64_CHARS=15000000

# Runtime persistence
MIAI_MEMORY_DB=data/miai_memory.sqlite3

# MiAI Admin — Owner Token control surface (used by the MiAI Admin Android app)
# Separate DB for owner settings + audit/system logs. Generate the Owner
# Token with: python scripts/generate_owner_token.py --url <URL-de-este-Core>
MIAI_ADMIN_DB=data/miai_admin.sqlite3

# MiAI V0.8 — robustness/context
MIAI_FALLBACK_PROVIDERS=
MIAI_RETRIES=1
MIAI_MAX_CONTEXT_CHARS=24000
MIAI_MEMORY_CONTEXT_CHARS=9000
MIAI_KNOWLEDGE_CONTEXT_CHARS=9000
MIAI_CONTEXT_RESERVE_CHARS=4000

# MiAI V0.9 — streaming, advanced sessions, semantic memory
MIAI_SEMANTIC_MEMORY=true
MIAI_EMBEDDING_MODEL=text-embedding-3-small
# Reuses MIAI_BASE_URL / MIAI_API_KEY when these are omitted.
# MIAI_EMBEDDING_BASE_URL=https://example.com/v1
# MIAI_EMBEDDING_API_KEY=pon-la-en-tu-entorno
MIAI_EMBEDDING_TIMEOUT=30

# MiAI V0.11 — RAG quality / hybrid semantic retrieval
# Reject weak knowledge matches before they reach the model context.
MIAI_RAG_MIN_SCORE=0.08
# RAG reuses MIAI_EMBEDDING_BASE_URL / MIAI_EMBEDDING_API_KEY when configured.

# MiAI V0.12-B4 — real embeddings / semantic RAG
# Any OpenAI-compatible embeddings server can be used. Never commit secrets.
# Example: https://api.openai.com/v1 or an Ollama-compatible gateway.
# MIAI_EMBEDDING_BASE_URL=https://example.com/v1
# MIAI_EMBEDDING_API_KEY=pon-la-en-tu-entorno
# MIAI_EMBEDDING_MODEL=text-embedding-3-small
# MIAI_EMBEDDING_TIMEOUT=30
